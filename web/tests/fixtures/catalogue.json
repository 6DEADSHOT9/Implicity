{
  "registry_version": 2,
  "components": ["ReviewPanel"],
  "catalogue": [
    {
      "name": "ReviewPanel",
      "role": "content",
      "props_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fail": { "type": "boolean" }
        },
        "required": ["count"],
        "additionalProperties": false
      },
      "slots": ["main"],
      "slots_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "main": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        },
        "required": ["main"],
        "additionalProperties": false
      },
      "limits": { "minWidth": 1, "minHeight": 1, "minContrast": 4.5 }
    }
  ]
}
