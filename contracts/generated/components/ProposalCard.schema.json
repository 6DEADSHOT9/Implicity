{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^prop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "proposal_type": {
          "type": "string",
          "enum": [
            "look",
            "widget",
            "workflow",
            "kind",
            "schedule",
            "dimension"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "preview": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "proposal_id",
        "proposal_type",
        "title",
        "description",
        "preview"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
