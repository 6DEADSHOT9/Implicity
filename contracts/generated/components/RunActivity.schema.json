{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "complete",
                  "error"
                ]
              }
            },
            "required": [
              "label",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "steps",
        "open"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {
        "steps": {
          "maxItems": 0,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
