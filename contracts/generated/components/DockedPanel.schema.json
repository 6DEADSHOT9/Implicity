{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "tabs": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Details",
              "History"
            ]
          },
          "uniqueItems": true
        },
        "activeTab": {
          "type": "string",
          "enum": [
            "Details",
            "History"
          ]
        },
        "open": {
          "type": "boolean"
        },
        "docked": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "tabs",
        "activeTab",
        "open",
        "docked"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {
        "main": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "main"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
