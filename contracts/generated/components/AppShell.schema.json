{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "panelOpen": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "panelOpen"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {
        "main": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "navigation": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "panel": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "main",
        "navigation",
        "panel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
