{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "web",
            "memory"
          ]
        }
      },
      "required": [
        "label",
        "url",
        "source_type"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
