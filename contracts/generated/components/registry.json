{
  "registry_version": 4,
  "components": [
    "AppShell",
    "ChangeNotice",
    "ChatHeader",
    "Composer",
    "ConversationNavigation",
    "Nudge",
    "ProposalCard",
    "Search",
    "Settings"
  ],
  "catalogue": [
    {
      "name": "AppShell",
      "role": "shell",
      "props_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "panelOpen": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "panelOpen"
        ],
        "additionalProperties": false
      },
      "slots": [
        "main",
        "navigation",
        "panel"
      ],
      "slots_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "main": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "navigation": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "panel": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        },
        "required": [
          "main",
          "navigation",
          "panel"
        ],
        "additionalProperties": false
      },
      "limits": {
        "minWidth": 320,
        "minHeight": 64,
        "minContrast": 4.5
      }
    },
