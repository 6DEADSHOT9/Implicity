          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "presentation": {
            "type": "string",
            "enum": [
              "inline",
              "toast"
            ]
          }
        },
        "required": [
          "decision_id",
          "title",
          "reason",
          "presentation"
