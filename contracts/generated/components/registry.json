{
  "registry_version": 3,
  "components": [
    "DockedPanel",
    "ProjectPanel",
    "SourcesPanel"
  ],
  "catalogue": [
    {
      "name": "DockedPanel",
      "role": "panel",
      "props_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "tabs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "activeTab": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "open": {
            "type": "boolean"
          },
          "docked": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "tabs",
          "activeTab",
          "open",
          "docked"
        ],
        "additionalProperties": false
      },
      "slots": [],
      "slots_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "limits": {
        "minWidth": 384,
        "minHeight": 160,
        "minContrast": 4.5
      }
    },
    {
      "name": "ProjectPanel",
      "role": "panel",
      "props_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "tabs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "decisions",
                    "constraints",
                    "files"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "activeTab": {
            "type": "string",
            "enum": [
              "decisions",
              "constraints",
              "files"
            ]
          }
        },
        "required": [
          "title",
          "tabs",
          "activeTab"
        ],
        "additionalProperties": false
      },
      "slots": [
        "decisions",
        "constraints",
        "files"
      ],
      "slots_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        },
        "additionalProperties": false
      },
      "limits": {
        "minWidth": 288,
        "minHeight": 180,
        "minContrast": 4.5
      }
    },
    {
      "name": "SourcesPanel",
      "role": "panel",
      "props_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "docked": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "web",
                    "document",
                    "other"
                  ]
                }
              },
              "required": [
                "title",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "docked"
        ],
        "additionalProperties": false
      },
      "slots": [],
      "slots_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "limits": {
        "minWidth": 240,
        "minHeight": 120,
        "minContrast": 4.5
      }
    }
  ]
}
