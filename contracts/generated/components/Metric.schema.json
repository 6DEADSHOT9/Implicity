{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "state": {
          "default": "default",
          "type": "string",
          "enum": [
            "default",
            "empty",
            "loading",
            "error"
          ]
        }
      },
      "required": [
        "label",
        "value",
        "state"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
