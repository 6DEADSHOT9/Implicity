{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "tabs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "decisions",
              "constraints",
              "files"
            ]
          }
        },
        "activeTab": {
          "type": "string",
          "enum": [
            "decisions",
            "constraints",
            "files"
          ]
        }
      },
      "required": [
        "title",
        "tabs",
        "activeTab"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "decisions",
        "constraints",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
