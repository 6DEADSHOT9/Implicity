{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "props": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^dec_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "type": "string",
          "enum": [
            "inline",
            "toast"
          ]
        }
      },
      "required": [
        "decision_id",
        "title",
        "reason",
        "presentation"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "required": [
    "props",
    "slots"
  ],
  "additionalProperties": false
}
